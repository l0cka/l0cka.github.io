---
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { featuredProjects } from "../data/projects";
---
<Base
  title="Daniel Alkurdi - Technology lawyer and software builder"
  description="Daniel Alkurdi is a technology lawyer in Sydney, working on access to justice and building open-source legal tools. Explore his personal software projects."
>
  <section class="hero wrap" aria-labelledby="intro-title">
    <h1 id="intro-title">Daniel Alkurdi</h1>
    <p class="hero-subtitle">Technology lawyer. Software builder.</p>
    <p class="standfirst">I’m a technology lawyer in Sydney, building open-source legal tools and software that makes AI systems easier to inspect and control.</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#work">Explore my work <span aria-hidden="true">↓</span></a>
      <a class="text-link" href="https://github.com/l0cka" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="section wrap" id="work" aria-labelledby="work-title">
    <SectionHead clause="01" title="Selected work" id="work-title" intro="Public projects & contributions" />
    <div class="project-list">
      {featuredProjects.map((project, index) => <ProjectRow project={project} index={index} />)}
    </div>
  </section>
  <section class="section wrap" id="about" aria-labelledby="about-title">
    <SectionHead clause="02" title="About" id="about-title" />
    <div class="about-grid">
      <h3>Law, technology and access to justice.</h3>
      <div class="about-copy">
        <p>I work as a Lawyer - Technology and Innovation in the Pro Bono + CSR team at Gilbert + Tobin in Sydney.</p>
        <p>My personal projects focus on practical legal workflows and making the behaviour of AI tools easier to check.</p>
        <a class="text-link" href="https://www.linkedin.com/in/danielalkurdi/" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Base>
