---
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { featuredProjects, moreProjects } from "../data/projects";
---

<Base
  title="Daniel Alkurdi — Technology lawyer and software builder"
  description="Public-interest legal technology, open-source legal workflows and software projects by Daniel Alkurdi."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="hero-eyebrow rise">
          <span class="mono">Sydney</span>
          <span class="label">Law · technology · public-interest tools</span>
        </div>
        <h1 class="rise rise-2">Lawyer by practice. <em>Builder by habit.</em></h1>
        <p class="standfirst rise rise-3">
          I’m Daniel Alkurdi, a technology lawyer and software builder in Sydney. I build
          open-source legal workflows, public-interest data products and tools that make AI
          systems easier to inspect and control.
        </p>
        <div class="hero-actions rise rise-4">
          <a class="btn btn-primary" href="#work">View selected work</a>
          <a class="btn" href="https://github.com/l0cka" target="_blank" rel="noreferrer">GitHub profile</a>
        </div>
      </div>
      <div class="cover-sheet rise rise-3" aria-label="At a glance">
        <div class="cover-sheet-head">
          <span class="label">Profile</span>
          <span class="mono">2026</span>
        </div>
        <dl>
          <div class="cover-row">
            <dt>Name</dt>
            <span class="leader" aria-hidden="true"></span>
            <dd>Daniel Alkurdi</dd>
          </div>
          <div class="cover-row">
            <dt>Public work</dt>
            <span class="leader" aria-hidden="true"></span>
            <dd>Register · package · tools</dd>
          </div>
          <div class="cover-row">
            <dt>Open source</dt>
            <span class="leader" aria-hidden="true"></span>
            <dd>Legal workflows · macOS</dd>
          </div>
          <div class="cover-row">
            <dt>Base</dt>
            <span class="leader" aria-hidden="true"></span>
            <dd>Sydney, Australia</dd>
          </div>
          <div class="cover-row">
            <dt>GitHub</dt>
            <span class="leader" aria-hidden="true"></span>
            <dd><a href="https://github.com/l0cka" target="_blank" rel="noreferrer">l0cka</a></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section" id="work">
    <div class="wrap">
      <SectionHead
        clause="01"
        label="Selected work"
        title="Work you can inspect."
        intro="Live products, released packages, open-source tools and upstream contributions."
      />
      <div class="project-list">
        {featuredProjects.map((project, index) => (
          <ProjectRow project={project} index={index} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead
        clause="02"
        label="Other work"
        title="Research and prototypes."
        intro="Smaller public projects that show the path, not a finished product claim."
      />
      <div class="minor-list">
        {moreProjects.map((item) => (
          <div class="minor-item">
            <strong>
              <a href={item.href} target="_blank" rel="noreferrer">{item.name}</a>
            </strong>
            <span class="leader" aria-hidden="true"></span>
            <span class="line">{item.line}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
